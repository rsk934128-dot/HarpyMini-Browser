{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and browser configuration preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "dataSaverEnabled": { "type": "boolean" },
        "adBlockEnabled": { "type": "boolean" },
        "searchEngine": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved bookmark entry for quick navigation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "icon": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "url"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "Browsing history record for non-incognito sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "visitedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "url", "visitedAt"]
    },
    "PasswordVaultItem": {
      "title": "PasswordVaultItem",
      "description": "Client-side AES-GCM encrypted credential vault entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "website": { "type": "string" },
        "username": { "type": "string" },
        "encryptedData": { "type": "string" },
        "iv": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "website", "encryptedData", "iv"]
    },
    "OfflinePage": {
      "title": "OfflinePage",
      "description": "Downloaded web page saved for offline reading",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "content": { "type": "string" },
        "savedAt": { "type": "string" },
        "sizeKb": { "type": "number" }
      },
      "required": ["id", "userId", "title", "url", "content", "savedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Individual user preferences and browser sync settings"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "User bookmarks subcollection"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/HistoryItem" },
      "description": "User browsing history entries subcollection"
    },
    "/users/{userId}/passwords/{passwordId}": {
      "schema": { "$ref": "#/entities/PasswordVaultItem" },
      "description": "Encrypted credentials stored safely per user"
    },
    "/users/{userId}/offlinePages/{pageId}": {
      "schema": { "$ref": "#/entities/OfflinePage" },
      "description": "Cached offline reading articles saved per user"
    }
  }
}
